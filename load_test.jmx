          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
	&quot;identificador&quot;: &quot;pedido productos aseo 11/05&quot;,&#xd;
	&quot;tiendaId&quot;: &quot;bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb&quot;,&#xd;
	&quot;fechaHoraCreacion&quot;: &quot;2026-02-11T10:00:00.000Z&quot;,&#xd;
	&quot;montoTotal&quot;: 1020.00,&#xd;
	&quot;monedaId&quot;: &quot;cccccccc-cccc-4ccc-8ccc-cccccccccccc&quot;,&#xd;
	&quot;items&quot;: [&#xd;
	  {&#xd;
	    &quot;productoId&quot;: &quot;aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa&quot;,&#xd;
	    &quot;cantidad&quot;: 10,&#xd;
	    &quot;precioUnitario&quot;: 25.5,&#xd;
	    &quot;descuento&quot;: 0,&#xd;
	    &quot;monedaId&quot;: &quot;cccccccc-cccc-4ccc-8ccc-cccccccccccc&quot;&#xd;
	  },&#xd;
	  {&#xd;
	    &quot;productoId&quot;: &quot;aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaab&quot;,&#xd;
	    &quot;cantidad&quot;: 10,&#xd;
	    &quot;precioUnitario&quot;: 25.5,&#xd;
	    &quot;descuento&quot;: 0,&#xd;
	    &quot;monedaId&quot;: &quot;cccccccc-cccc-4ccc-8ccc-cccccccccccc&quot;&#xd;
	  },&#xd;
	  {&#xd;
	    &quot;productoId&quot;: &quot;aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaac&quot;,&#xd;
	    &quot;cantidad&quot;: 10,&#xd;
	    &quot;precioUnitario&quot;: 25.5,&#xd;
	    &quot;descuento&quot;: 0,&#xd;
	    &quot;monedaId&quot;: &quot;cccccccc-cccc-4ccc-8ccc-cccccccccccc&quot;&#xd;
	  },&#xd;
	  {&#xd;
	    &quot;productoId&quot;: &quot;aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaad&quot;,&#xd;
	    &quot;cantidad&quot;: 10,&#xd;
	    &quot;precioUnitario&quot;: 25.5,&#xd;
	    &quot;descuento&quot;: 0,&#xd;
	    &quot;monedaId&quot;: &quot;cccccccc-cccc-4ccc-8ccc-cccccccccccc&quot;&#xd;
	  }&#xd;
	]&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
